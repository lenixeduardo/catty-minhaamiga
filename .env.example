GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
PORT=3001

# Visitante temporário apenas em localhost. Use false para exigir login.
DEV_GUEST_MODE=true

# Origens permitidas para WebSocket/guest (separadas por vírgula). Ex: localhost:5173,app.seudominio.com
ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173

# IPs confiáveis atrás de proxy reverso (separados por vírgula)
TRUSTED_PROXIES=127.0.0.1
